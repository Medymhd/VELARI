{
  "name": "@app/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./db": "./dist/db.js"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push --skip-generate",
    "db:migrate:dev": "prisma migrate dev --name init",
    "test": "node --test dist/**/*.test.js"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@app/agent-sdk": "workspace:*",
    "@app/ai-runtime": "workspace:*",
    "@app/contracts": "workspace:*",
    "@app/domain": "workspace:*",
    "@app/observability": "workspace:*",
    "@app/security": "workspace:*",
    "@app/vertical-interview-intelligence": "workspace:*",
    "@app/vertical-work-assistant": "workspace:*",
    "@aws-sdk/client-s3": "^3.1118.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.0.1",
    "@prisma/client": "^6.2.1",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
