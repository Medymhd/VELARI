# ── Platform API ────────────────────────────────────────────────
PORT=8787
NODE_ENV=development
DATABASE_URL=postgresql://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-dev-only
# Master key for envelope-encrypting BYOK provider secrets (32 bytes hex)
SECRET_MASTER_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
# Public origin clients dial for websocket endpoints (ws(s):// derived from http(s))
PUBLIC_URL=http://localhost:8787
# HMAC secret for short-lived STT relay session tokens
RELAY_HMAC_SECRET=change-me-dev-only

# ── STT providers ───────────────────────────────────────────────
# Streaming partials + finals (paid, highest quality)
DEEPGRAM_API_KEY=
# Local Whisper server (OpenAI-compatible /v1 base, e.g. faster-whisper-server); unset = simulated
LOCAL_WHISPER_URL=
LOCAL_WHISPER_AVAILABLE=0
# Sherpa Zipformer model dir (auto-downloaded to models/sherpa if unset)
SHERPA_MODEL_DIR=

# ── Object storage (MinIO in dev) ──────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=app
S3_SECRET_KEY=app-secret
S3_BUCKET=app-artifacts

# ── Managed LLM providers (free tiers used first) ──────────────
# Groq — primary coach routing (measured TTFT 0.56s, free tier)
GROQ_API_KEY=
# b.ai — OpenAI-compatible gateway (vision + coach)
BAI_API_KEY=
# Google Gemini (free tier)
GEMINI_API_KEY=
# HuggingFace Inference (free credits)
HUGGINGFACE_API_KEY=
# Fireworks (paid — comment out unless needed)
# FIREWORKS_API_KEY=
# OpenAI (paid — comment out unless needed)
# OPENAI_API_KEY=
# DeepSeek (paid — comment out unless needed)
# DEEPSEEK_API_KEY=
# Zhipu (account has no free quota)
# ZHIPU_API_KEY=

# ── Benchmark gateways ─────────────────────────────────────────
# OpenRouter free models for benchmark comparisons
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openrouter/free,nvidia/nemotron-3-super-120b-a12b:free,minimax/minimax-m3:free
OPENROUTER_VISION_MODEL=
# b.ai OpenAI-compatible gateway
OPENAI_COMPAT_ID=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODELS=
OPENAI_COMPAT_VISION_MODEL=

# ── Embeddings (pgvector recall) ───────────────────────────────
# Free lexical hash embedder used when unset; set for semantic recall
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ── TTS (OpenAI-compatible speech endpoint) ────────────────────
# Used by the overlay speak button when Piper is not configured
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=

# ── Piper TTS (premium local voice, MIT, ~60 MB model) ─────────
# Download: https://github.com/rhasspy/piper/releases
PIPER_PATH=
PIPER_MODEL_PATH=
PIPER_CONFIG_PATH=

# ── Playwright browser automation ──────────────────────────────
# Browser channel: chrome | msedge | chromium
PLAYWRIGHT_CHANNEL=

# ── Integrations (OAuth + HMAC webhooks) ───────────────────────
CALENDAR_WEBHOOK_SECRET=
SLACK_SIGNING_SECRET=

# ── Desktop ─────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8787/v1
