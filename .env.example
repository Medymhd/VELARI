# ── Platform API ────────────────────────────────────────────────
PORT=8787
NODE_ENV=development
DATABASE_URL=postgresql://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-dev-only
# Master key for envelope-encrypting BYOK provider secrets (32 bytes hex)
SECRET_MASTER_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
# Public origin clients dial for websocket endpoints (ws(s):// derived from http(s))
PUBLIC_URL=http://localhost:8787
# HMAC secret for short-lived STT relay session tokens
RELAY_HMAC_SECRET=change-me-dev-only
# Fallback Deepgram key when a workspace has no BYOK provider connection
DEEPGRAM_API_KEY=
# Local STT server (OpenAI-compatible /v1 base, e.g. faster-whisper-server); unset = simulated
LOCAL_WHISPER_URL=

# Object storage (MinIO in dev)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=app
S3_SECRET_KEY=app-secret
S3_BUCKET=app-artifacts

# ── Desktop ─────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8787/v1
