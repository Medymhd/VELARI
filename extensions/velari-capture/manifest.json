{
  "manifest_version": 3,
  "name": "Velari Capture",
  "version": "0.1.0",
  "description": "Capture page text into your live Velari session (Ctrl+Shift+Y).",
  "permissions": ["activeTab", "scripting", "storage", "notifications"],
  "host_permissions": ["http://localhost:8787/*", "http://127.0.0.1:8787/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "commands": {
    "capture-page": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Capture the active page into Velari"
    }
  }
}
